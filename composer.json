{
    "name": "wiistriker/doctrine-cursor-paginator",
    "description": "Iterate through large datasets",
    "keywords": ["symfony","doctrine","deep-page-problem","cursor-based-pagination","seek method","keyset pagination"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "symfony/property-access": "^4.4 || ^5.0 || ^6.0 || ^7.0 || ^8.0"
    },
    "suggest": {
        "doctrine/orm": "Required to use DoctrineORMCursorPaginator",
        "doctrine/dbal": "Required to use DoctrineDBALCursorPaginator"
    },
    "require-dev": {
        "doctrine/orm": "^2.6 || ^3.0",
        "phpunit/phpunit": "^9",
        "symfony/cache": "*",
        "colinodell/psr-testlogger": "^1.3",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {"Wiistriker\\DoctrineCursorPaginator\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    }
}
